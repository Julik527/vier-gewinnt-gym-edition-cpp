{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Vier Gewinnt bauen",
      "type": "process",
      "command": "C:/msys64/ucrt64/bin/g++.exe",
      "args": [
        "-std=c++17",
        "-g",
        "-O0",
        "-Wall",
        "-Wextra",
        "-Wpedantic",
        "-Iinclude",
        "src/main.cpp",
        "src/Board.cpp",
        "src/Game.cpp",
        "src/ConsoleUI.cpp",
        "-o",
        "vier-gewinnt.exe"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": [
        "$gcc"
      ],
      "presentation": {
        "reveal": "always",
        "panel": "shared",
        "clear": true
      },
      "detail": "C++17-Debug-Build der vorhandenen Konsolenversion. Relative Pfade reduzieren Windows-/MSYS2-Zeichensatzprobleme."
    }
  ]
}
