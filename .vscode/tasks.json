{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Vier Gewinnt konfigurieren",
      "type": "process",
      "command": "C:/msys64/ucrt64/bin/cmake.exe",
      "args": [
        "--preset",
        "console",
        "-DCMAKE_C_COMPILER=C:/msys64/ucrt64/bin/gcc.exe",
        "-DCMAKE_CXX_COMPILER=C:/msys64/ucrt64/bin/g++.exe"
      ],
      "options": {
        "cwd": "${workspaceFolder}",
        "env": {
          "PATH": "C:/msys64/ucrt64/bin;${env:PATH}"
        }
      },
      "problemMatcher": []
    },
    {
      "label": "Vier Gewinnt bauen",
      "type": "process",
      "command": "C:/msys64/ucrt64/bin/cmake.exe",
      "args": [
        "--build",
        "--preset",
        "console",
        "--target",
        "vier-gewinnt",
        "--parallel",
        "2"
      ],
      "dependsOn": [
        "Vier Gewinnt konfigurieren"
      ],
      "dependsOrder": "sequence",
      "options": {
        "cwd": "${workspaceFolder}",
        "env": {
          "PATH": "C:/msys64/ucrt64/bin;${env:PATH}"
        }
      },
      "problemMatcher": [
        "$gcc"
      ],
      "group": {
        "kind": "build",
        "isDefault": true
      }
    },
