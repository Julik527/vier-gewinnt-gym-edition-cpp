{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Vier Gewinnt bauen",
      "type": "shell",
      "command": "C:/msys64/ucrt64/bin/g++.exe",
      "args": [
        "-std=c++17",
        "-Wall",
        "-Wextra",
        "-pedantic",
        "-Iinclude",
        "src/main.cpp",
        "src/Board.cpp",
        "src/Game.cpp",
        "-o",
        "vier-gewinnt.exe"
      ],
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": [
        "$gcc"
      ]
    }
  ]
}