{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Vier Gewinnt | Gym Edition",
      "type": "cppdbg",
      "request": "launch",
      "program": "${workspaceFolder}/vier-gewinnt.exe",
      "args": [],
      "stopAtEntry": false,
      "cwd": "${workspaceFolder}",
      "externalConsole": false,
      "MIMode": "gdb",
      "miDebuggerPath": "C:/msys64/ucrt64/bin/gdb.exe",
      "preLaunchTask": "Vier Gewinnt bauen",
      "setupCommands": [
        {
          "description": "Pretty Printing aktivieren",
          "text": "-enable-pretty-printing",
          "ignoreFailures": true
        }
      ],
      "internalConsoleOptions": "neverOpen"
    },
    {
      "name": "Vier Gewinnt | Gym Edition 2D",
      "type": "cppdbg",
      "request": "launch",
      "program": "${workspaceFolder}/build-gui/vier-gewinnt-gui.exe",
      "args": [],
      "stopAtEntry": false,
      "cwd": "${workspaceFolder}",
      "externalConsole": false,
      "MIMode": "gdb",
      "miDebuggerPath": "C:/msys64/ucrt64/bin/gdb.exe",
      "preLaunchTask": "Gym Edition 2D bauen",
      "environment": [
        {
          "name": "PATH",
          "value": "C:/msys64/ucrt64/bin;${env:PATH}"
        }
      ],
      "internalConsoleOptions": "neverOpen"
    }
  ]
}
